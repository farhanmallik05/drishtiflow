# ==============================================================================
# DrishtiFlow Environment Configuration Blueprint
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env and provide your environment-specific credentials.
# ==============================================================================

# Application Environment
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Database & Persistence (Server-side Only)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drishtiflow
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# AI Models & Vision Verification (Server-side Only)
# ------------------------------------------------------------------------------
WORKFLOW_COMPILER_PROVIDER=gemini # or 'groq'
WORKFLOW_COMPILER_API_KEY=your-compiler-api-key
VISION_PROVIDER=gemini # or 'mock' for explicitly selected offline demo mode
VISION_API_KEY=your-vision-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=your-groq-api-key

# Local Inference Fallback (Ollama / Local Server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava

# ------------------------------------------------------------------------------
# Action Providers & Notification Services (Server-side Only)
# ------------------------------------------------------------------------------
# Vapi Outbound Phone Alert
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_DESTINATION_PHONE_NUMBER=+91XXXXXXXXXX

# WhatsApp Cloud API Notification
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_RECIPIENT_PHONE_NUMBER=+91XXXXXXXXXX

# ------------------------------------------------------------------------------
# Evidence Storage & Retention
# ------------------------------------------------------------------------------
EVIDENCE_BUCKET=drishtiflow-evidence
EVIDENCE_RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# Edge Agent Authentication (Local Agent Daemon)
# ------------------------------------------------------------------------------
EDGE_AGENT_ID=agent-edge-01
EDGE_AGENT_TOKEN=your-edge-agent-secret-token

