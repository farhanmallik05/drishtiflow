{
  "name": "drishtiflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "DrishtiFlow - Event-Aware Edge Vision Intelligence Platform for Bharat Sites",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
